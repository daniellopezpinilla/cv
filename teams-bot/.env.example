# App Registration en Entra ID (Azure AD)
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=

# Horario
TIMEZONE=America/Bogota
# true = responde aunque sea horario laboral (solo para pruebas)
FORCE_OFF_HOURS=false

# === Destino Teams (elige UNA opción) ===

# A) RECOMENDADO: mensajes directos a la cuenta de soporte
#    UPN (correo) u Object ID del usuario de soporte
SUPPORT_USER_ID=soporteAppsHalliburton@ecopetrol.com.co

# B) Un solo chat (prueba / legacy)
TEAMS_CHAT_ID=

# C) Canal de un Team
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=

# Polling
POLL_INTERVAL_SECONDS=60
STATE_PATH=data/poll_state.json
# Solo revisa los N chats 1:1 más recientes por ciclo (1 página ≈ 50 chats)
MAX_CHAT_PAGES=1
MESSAGES_PER_CHAT=5

# Respuesta fuera de horario
REPLY_TEXT=Hola, este es el soporte automático de Aplicaciones.\n\nActualmente estamos fuera de horario laboral (lunes a viernes 6:00 p.m. – 6:00 a.m., y fines de semana). Por favor crea un caso siguiendo la guía adjunta. Tu solicitud será atendida en el próximo día hábil.
PDF_PATH=assets/guia_crear_caso.pdf
PDF_FILENAME=guia_crear_caso.pdf
